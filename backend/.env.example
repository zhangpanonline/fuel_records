# 数据库类型: sqlite（本地开发，无需安装）| postgresql（生产）| postgresql_test（测试库）| mysql
#
# [!CAUTION] 本地/手动测试必须用 postgresql_test，禁止直连生产数据库（postgresql）。
#            生产数据库仅由 Render 自动连接，不做手动操作。
DB_TYPE=sqlite

# 服务配置
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# 日志配置
LOG_LEVEL=DEBUG
LOG_FILE=logs/fuel_records.log

# PostgreSQL 生产数据库（DB_TYPE=postgresql 时生效）
# DB_PG_URL=postgresql://postgres.xxx:password@aws-0-xxx.pooler.supabase.com:6543/postgres

# PostgreSQL 测试数据库（DB_TYPE=postgresql_test 时生效）
# DB_PG_URL_TEST=postgresql://postgres.xxx:password@aws-0-xxx.pooler.supabase.com:6543/postgres

# MySQL 配置（DB_TYPE=mysql 时生效）
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_password_here
# DB_NAME=fuel_records
