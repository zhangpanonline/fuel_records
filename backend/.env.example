# 数据库类型: sqlite（本地开发，无需安装）| mysql（生产/部署，需要 MySQL 服务）
DB_TYPE=sqlite

# 服务配置
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# 日志配置
LOG_LEVEL=DEBUG
LOG_FILE=logs/fuel_records.log

# MySQL 配置（DB_TYPE=mysql 时生效）
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_password_here
# DB_NAME=fuel_records
